# PostgreSQL — dùng docker-compose (cổng 5433) HOẶC pnpm db:embedded (cũng cổng 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/webcatt?schema=public"

PORT=3001

# Đổi thành chuỗi bí mật ngẫu nhiên khi triển khai thật
# BẮT BUỘC, tối thiểu 32 ký tự — máy chủ từ chối khởi động nếu thiếu.
# Sinh khóa: openssl rand -base64 48
JWT_SECRET="doi-thanh-chuoi-bi-mat-ngau-nhien-that-dai-truoc-khi-chay"

# URL của web (CORS + returnUrl khi thanh toán)
WEB_URL="http://localhost:3000"
# URL công khai của API (Binance gọi webhook về địa chỉ này — cần domain public khi chạy thật)
API_PUBLIC_URL="http://localhost:3001"

# true  = giả lập cổng thanh toán (không cần tài khoản Binance Merchant, dùng để dev/demo)
# false = gọi Binance Pay thật (cần API key/secret bên dưới)
PAYMENT_MOCK=true
BINANCE_PAY_BASE_URL="https://bpay.binanceapi.com"
BINANCE_PAY_API_KEY=""
BINANCE_PAY_API_SECRET=""

# --- Binance (tài khoản thường): đọc số dư + tự khớp nạp USDT on-chain (BEP20/TRC20) ---
# Chỉ cần quyền "Enable Reading". KHÔNG bật Withdraw/Trade. Nên giới hạn IP.
# Để trống = tắt tự khớp crypto (admin vẫn xác nhận thủ công bằng TxID được).
BINANCE_API_KEY=""
BINANCE_SECRET_KEY=""
BINANCE_API_BASE_URL="https://api.binance.com"

# Đơn hàng chưa thanh toán sẽ hết hạn sau số phút này (kho được nhả lại)
ORDER_EXPIRE_MINUTES=30

# --- Tự động dịch nội dung sang tiếng Anh + tiếng Trung (Claude API) ---
# Lấy khóa tại https://platform.claude.com → API keys.
# Bỏ trống thì nút "Dịch tự động" trong trang quản trị sẽ báo chưa cấu hình,
# mọi chức năng khác vẫn chạy bình thường.
ANTHROPIC_API_KEY=""

# Tài khoản admin được tạo khi chạy seed
ADMIN_EMAIL="admin@cattstore.local"
ADMIN_PASSWORD="Admin@123"

# true = seed tạo thêm sản phẩm/khách hàng/thông báo MẪU để xem thử.
# Cửa hàng thật để trống/false — seed chỉ bảo đảm có tài khoản chủ shop.
SEED_DEMO="false"
