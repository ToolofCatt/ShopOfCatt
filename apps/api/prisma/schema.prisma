generator client {
  provider = "prisma-client-js"
  // "native" cho máy dev; musl cho image Docker Alpine
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  /// Chủ cửa hàng — duy nhất có quyền cấp/thu hồi quyền admin
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  CANCELLED
  EXPIRED
}

/// Cách chọn dòng kho khi giữ chỗ cho đơn.
enum StockDrawMode {
  /// Cũ trước, mới sau — đúng thứ tự nạp vào kho.
  SEQUENTIAL
  /// Ngẫu nhiên. Dùng cho loại hàng mà mỗi key một khác (ví dụ tài khoản còn
  /// số ngày ngẫu nhiên), để khách trước không vét hết những key "ngon".
  RANDOM
}

enum StockStatus {
  AVAILABLE
  RESERVED
  SOLD
  /// Chủ shop tự rút ra khỏi kho — không bán được nữa, nhưng KHÔNG tính là đã
  /// bán nên không vào doanh thu. Giữ lại dòng thay vì xoá để còn dấu vết.
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum DiscountType {
  /// Giảm theo phần trăm (value = 1..100)
  PERCENT
  /// Giảm số tiền cố định (value = số USDT)
  FIXED
}

model User {
  id String @id @default(cuid())
  /// Mã khách hàng ngẫu nhiên 8 chữ số — không lộ số lượng/tăng trưởng khách
  code         Int      @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  /// Khác null = tài khoản đang bị khóa (không đăng nhập/gọi API được)
  lockedAt DateTime?
  /// Lần đổi mật khẩu gần nhất — token cấp TRƯỚC mốc này bị từ chối
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  orders            Order[]
  auditLogs         AuditLog[]
}

/// Nhật ký thao tác của quản trị viên — ai làm gì, lúc nào.
model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Ảnh chụp — vẫn đọc được nếu tài khoản bị xóa
  actorEmail String
  actorCode  Int
  /// Khoá hành động, ví dụ "product.update", "customer.lock"
  action     String
  entityType String?
  entityId   String?
  /// Chi tiết ngắn gọn (tên, thay đổi giá...), hiển thị ở trang nhật ký
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model Product {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String?
  description      String?
  currency         String  @default("USDT")
  /// Ảnh bìa, bản lớn. KHÔNG truy vấn nào ngoài endpoint phục vụ ảnh được select
  /// cột này — nó là base64 vài trăm KB.
  image            String?
  /// Bản thu nhỏ (~400px) của ảnh bìa. Cũng chỉ endpoint phục vụ ảnh mới đọc.
  thumbnail        String?
  /// Cỡ ảnh sau giải mã, tính bằng byte. `null` = chưa có ảnh.
  ///
  /// Tồn tại để biết CÓ ảnh hay không mà không phải select cột base64: truy vấn
  /// danh sách chỉ cần dựng địa chỉ ảnh, và dựng được thì phải biết ảnh có tồn
  /// tại. Kèm theo là số để trang quản trị hiện dung lượng.
  imageBytes       Int?
  thumbnailBytes   Int?
  category         String?
  sortOrder        Int     @default(0)
  active           Boolean @default(true)

  /// Cách rút kho khi giữ chỗ cho đơn — áp dụng cho MỌI loại của sản phẩm này.
  ///
  /// Đặt ở Product chứ không ở ProductVariant: các loại của cùng một sản phẩm
  /// là cùng một thứ hàng, chỉ khác gói; để mỗi loại một kiểu rút là chủ shop
  /// phải nhớ cấu hình ở nhiều chỗ mà chẳng được gì.
  stockDrawMode    StockDrawMode @default(SEQUENTIAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mỗi sản phẩm có ít nhất một loại; giá nằm ở từng loại
  variants     ProductVariant[]
  translations ProductTranslation[]
  orderItems   OrderItem[]
  viewsDaily   ProductViewDaily[]
  images       ProductImage[]
}

/// Ảnh phụ của sản phẩm (ảnh bìa vẫn nằm ở cột `Product.image`).
///
/// Để riêng một bảng chứ không nhét mảng vào cột của `Product`: truy vấn danh
/// sách sản phẩm chạy ở mọi lần mở trang chủ, mà cột nằm trong `Product` là lần
/// nào cũng kéo cả đống base64 về dù thẻ sản phẩm chỉ cần một ảnh nhỏ.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Data URI đã nén ở trình duyệt trước khi gửi lên. Chỉ endpoint phục vụ ảnh
  /// mới được select cột này.
  data      String
  /// Cỡ ảnh sau giải mã, tính bằng byte — để khỏi phải đọc `data` chỉ vì cần số.
  bytes     Int     @default(0)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

/// Lượt xem trang sản phẩm, GỘP THEO NGÀY.
///
/// Không lưu từng lượt: bảng sự kiện phình vô hạn, mà thứ chủ shop cần chỉ là xu
/// hướng theo ngày. Gộp sẵn thì số dòng bị chặn ở (số sản phẩm × số ngày).
///
/// Không lưu IP hay userId — chỉ cần con số, không cần biết ai xem.
model ProductViewDaily {
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Ngày theo giờ máy chủ, không kèm giờ phút
  day   DateTime @db.Date
  views Int      @default(0)

  @@id([productId, day])
  @@index([day])
}

/// Từ khoá khách gõ ở ô tìm kiếm, GỘP THEO NGÀY.
///
/// `zeroResults` mới là con số đáng giá: nó nói cho chủ shop biết khách đang tìm
/// thứ cửa hàng KHÔNG có — tức là nên nhập hàng gì tiếp.
model SearchQueryDaily {
  /// Đã chuẩn hoá: cắt khoảng trắng thừa, chữ thường, tối đa 60 ký tự
  term String
  day  DateTime @db.Date
  /// Tổng số lần tìm bằng từ khoá này
  count Int @default(0)
  /// Trong đó bao nhiêu lần không ra kết quả nào
  zeroResults Int @default(0)

  @@id([term, day])
  @@index([day])
}

/// Một "loại" của sản phẩm (ví dụ: gói 1 tháng / 1 năm) — có giá và kho riêng.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String

  /// Giá quy ra USDT — con số DẪN XUẤT, dùng cho mọi phép tính tiền. Khi neo
  /// theo ₫ / ¥ thì nó được tính lại mỗi lần tỉ giá đổi.
  ///
  /// SÁU chữ số thập phân, không phải hai: với hai chữ số thì hai mức giá kề
  /// nhau cách nhau ~260 ₫, nên số tròn bằng đồng không nằm trên lưới đó được.
  price Decimal @db.Decimal(18, 6)

  /// Đơn vị chủ shop đã gõ giá bằng: "USDT" | "VND" | "USD" | "CNY" — cái NEO.
  priceCurrency String @default("USDT")

  /// Số tiền đúng như chủ shop đã gõ, theo `priceCurrency`. Đây mới là NGUỒN
  /// SỰ THẬT của giá; `price` được suy ra từ nó.
  priceAmount Decimal @db.Decimal(18, 2)

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems   StockItem[]
  orderItems   OrderItem[]
  translations ProductVariantTranslation[]

  @@index([productId, active])
}

/// Bản dịch của sản phẩm sang một ngôn ngữ khác tiếng Việt ("en" | "zh").
model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           String
  name             String
  shortDescription String?
  description      String?
  category         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locale])
}

model ProductVariantTranslation {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locale    String
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, locale])
}

model StockItem {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  content     String
  status      StockStatus    @default(AVAILABLE)
  orderItemId String?
  orderItem   OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  soldAt      DateTime?
  /// Lúc chủ shop rút dòng này ra khỏi kho.
  withdrawnAt DateTime?

  @@index([variantId, status])
  @@index([orderItemId])
}

model Order {
  id     String      @id @default(cuid())
  code   String      @unique
  userId String
  user   User        @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)
  /// Tiền hàng trước khi giảm giá.
  ///
  /// SÁU chữ số thập phân, khớp với `ProductVariant.price`: cắt về hai chữ số ở
  /// đây là phá luôn giá neo theo ₫ — đơn 100.000 ₫ thành 3.85 USDT rồi quy
  /// ngược lại ra 99.943 ₫, đúng cái lỗi mà việc neo giá sinh ra để chữa.
  subtotalAmount Decimal @default(0) @db.Decimal(18, 6)
  /// Số tiền được giảm bởi mã giảm giá
  discountAmount Decimal @default(0) @db.Decimal(18, 6)
  /// Số tiền khách phải trả = subtotalAmount - discountAmount
  totalAmount Decimal @db.Decimal(18, 6)
  couponId    String?
  coupon      Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Ảnh chụp mã đã dùng — vẫn đọc được nếu mã bị xóa
  couponCode String?
  currency   String      @default("USDT")
  createdAt  DateTime    @default(now())
  expiresAt  DateTime?
  paidAt     DateTime?
  items      OrderItem[]
  payment    Payment?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([couponId])
}

/// Mã giảm giá. `usedCount` được GIỮ CHỖ ngay khi đặt hàng và trả lại khi đơn
/// bị hủy/hết hạn, nên mã không bao giờ bị dùng quá số lần cho phép.
model Coupon {
  id String @id @default(cuid())
  /// Luôn lưu chữ HOA — so khớp không phân biệt hoa thường
  code String       @unique
  type DiscountType
  /// PERCENT: 1..100 (%) — FIXED: số USDT
  value Decimal @db.Decimal(18, 2)
  /// Giá trị đơn tối thiểu mới dùng được mã
  minAmount Decimal @default(0) @db.Decimal(18, 2)
  /// Tổng số lần dùng tối đa; null = không giới hạn
  maxUses   Int?
  usedCount Int  @default(0)
  /// Số lần tối đa MỘT khách được dùng; null = không giới hạn
  perUserLimit Int?
  startsAt     DateTime?
  expiresAt    DateTime?
  active       Boolean   @default(true)
  /// Ghi chú nội bộ, chỉ admin thấy
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([active, expiresAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Ảnh chụp tại thời điểm đặt hàng — không đổi khi sản phẩm bị sửa/xóa
  productName String
  variantName String          @default("")
  /// Ảnh chụp giá USDT lúc đặt — sáu chữ số như `ProductVariant.price`.
  unitPrice   Decimal         @db.Decimal(18, 6)
  quantity    Int
  stockItems  StockItem[]

  /// Tra theo orderId chạy BÊN TRONG giao dịch giao hàng (đang giữ khoá dòng),
  /// không có index là quét tuần tự cả bảng ngay giữa đường tiền.
  @@index([orderId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String        @default("BINANCE_PAY")
  mode            String        @default("MOCK")
  merchantTradeNo String        @unique
  prepayId        String?
  amount          Decimal       @db.Decimal(18, 6)
  currency        String        @default("USDT")
  status          PaymentStatus @default(PENDING)
  checkoutUrl     String?
  qrcodeLink      String?
  deeplink        String?
  universalUrl    String?
  rawWebhook      Json?
  /// Thanh toán crypto on-chain: "BEP20" | "TRC20". Null với mode BINANCE_ID.
  cryptoNetwork String?
  /// Nơi nhận tiền, chụp lại lúc tạo đơn: địa chỉ ví với CRYPTO, Binance ID với
  /// BINANCE_ID, số tài khoản ngân hàng với SEPAY. Chốt tại đây để chủ shop đổi
  /// ví/ID/tài khoản sau đó thì đơn đang chờ vẫn trỏ đúng chỗ đã báo khách.
  cryptoAddress String?
  /// SEPAY: ngân hàng nhận tiền, chụp lại cùng số tài khoản ở trên. Đổi ngân
  /// hàng mà không chụp lại là khách chuyển vào tài khoản không còn ai theo dõi.
  sepayBank     String?
  /// SEPAY: số tiền VND phải chuyển, làm tròn LÊN tới đồng.
  ///
  /// Ngân hàng không nhận số lẻ nhỏ hơn đồng, mà đối chiếu thì phải khớp tuyệt
  /// đối — nên số này được chốt lúc tạo đơn và không tính lại theo tỉ giá mới.
  vndAmount     Decimal? @db.Decimal(18, 0)
  /// SEPAY: id giao dịch SePay đã khớp.
  /// @unique là hàng rào CHỐNG DÙNG LẠI — webhook có thể được gửi lại nhiều lần.
  sepayRef      String?  @unique
  /// Số USDT DUY NHẤT khách phải gửi để hệ thống khớp đúng đơn (thêm phần lẻ).
  /// Dùng chung cho cả CRYPTO lẫn BINANCE_ID — giao dịch nào cũng không mang mã
  /// đơn, nên số tiền chính là mã đơn.
  cryptoAmount Decimal? @db.Decimal(18, 6)
  /// Mã giao dịch đã khớp: TxID on-chain với CRYPTO, transactionId của Binance
  /// Pay với BINANCE_ID.
  /// @unique là hàng rào CHỐNG DÙNG LẠI: một khoản tiền chỉ trả được cho MỘT
  /// đơn, kể cả khi nhiều request cùng khai một mã trong cùng một khoảnh khắc.
  cryptoTxId String?  @unique

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Bộ quét đối soát lọc theo (mode, status) mỗi 60 giây
  @@index([mode, status])
}

/// Cấu hình cửa hàng — bản ghi duy nhất id = "main". Địa chỉ ví KHÔNG bí mật
/// nên để trong DB cho admin sửa; khóa API Binance để trong biến môi trường.
model StoreSetting {
  id String @id @default("main")
  /// Cổng thanh toán giả lập — MẶC ĐỊNH TẮT. Chỉ có tác dụng khi biến môi
  /// trường PAYMENT_MOCK=true; bật nhầm ở môi trường thật = phát hàng miễn phí.
  mockEnabled       Boolean  @default(false)
  /// Binance Pay MERCHANT (cần tài khoản merchant riêng + khoá BINANCE_PAY_*)
  binancePayEnabled Boolean  @default(false)
  /// Binance Pay CÁ NHÂN: khách chuyển USDT thẳng tới Binance ID của chủ shop.
  /// Khác hẳn merchant — chỉ cần khoá đọc là đối soát được qua lịch sử Pay.
  binanceIdEnabled  Boolean  @default(false)
  /// Binance ID nhận tiền, ví dụ "1240006466"
  binanceId         String   @default("")
  /// Ảnh QR nhận tiền của Binance Pay, do chủ shop tự tải lên (data URI).
  ///
  /// KHÔNG dựng được từ Binance ID: mã QR của Binance chứa một liên kết nội bộ
  /// có token riêng, không suy ra từ số ID. Mã hoá số ID trần thì app Binance
  /// quét không hiểu — thà để chủ shop chụp QR trong app rồi tải lên.
  binanceQr         String   @default("")
  cryptoEnabled     Boolean  @default(false)
  bep20Address      String   @default("")
  trc20Address      String   @default("")

  /// --- SePay: nhận chuyển khoản ngân hàng VND, xác nhận bằng webhook ---
  sepayEnabled       Boolean @default(false)
  /// Số tài khoản nhận tiền và ngân hàng (tên ngắn kiểu "Vietcombank", hoặc BIN).
  sepayAccountNumber String  @default("")
  sepayBank          String  @default("")
  /// Tên chủ tài khoản — chỉ để hiện lên mã QR cho khách yên tâm.
  sepayAccountHolder String  @default("")
  /// Khoá API mà SePay gửi kèm mỗi webhook (`Authorization: Apikey ...`).
  ///
  /// Là BÍ MẬT: không bao giờ nằm trong AdminStoreSettingDto, không vào nhật ký.
  /// Rỗng = webhook bị từ chối sạch, vì không có gì để đối chiếu.
  sepayApiKey        String  @default("")
  /// Khoá bí mật để kiểm HMAC-SHA256 (tuỳ chọn, SePay khuyến nghị).
  /// Rỗng = chỉ kiểm khoá API. Có = kiểm THÊM chữ ký, không thay thế.
  sepayWebhookSecret String  @default("")
  /// Bao nhiêu VND cho 1 USDT. Giá bán ghi bằng USDT còn ngân hàng báo VND, nên
  /// không có tỉ giá thì không dựng được số tiền để đối chiếu.
  /// 0 = chưa cấu hình ⇒ KHÔNG chào phương thức này (fail-closed).
  ///
  /// Đây là tỉ giá ĐANG DÙNG, đã cộng biên. Bật rateAuto thì nó bị ghi lại mỗi
  /// ngày; tắt thì chủ shop tự nhập.
  vndPerUsdt         Decimal @default(0) @db.Decimal(18, 2)

  /// --- Tỉ giá hiển thị ---
  /// Bao nhiêu CNY cho 1 USDT — chỉ để HIỆN GIÁ cho khách chọn tiếng Trung,
  /// không dùng để thu tiền. 0 = không quy đổi, hiện USDT như cũ.
  cnyPerUsdt         Decimal  @default(0) @db.Decimal(18, 4)
  /// Tự lấy tỉ giá mỗi ngày từ nguồn công khai.
  rateAuto           Boolean  @default(false)
  /// Phần trăm cộng thêm lên tỉ giá thị trường.
  ///
  /// Có vì bán USDT ra tiền mặt luôn được giá thấp hơn tỉ giá niêm yết; để 0 là
  /// cửa hàng chịu phần chênh đó. Cộng cho CẢ VND và CNY để giá quy đổi ở mọi
  /// ngôn ngữ tương đương nhau.
  rateMarkupPercent  Decimal  @default(0) @db.Decimal(5, 2)
  /// Giờ lấy tỉ giá mỗi ngày, theo GIỜ VIỆT NAM (0–23).
  ///
  /// Giờ cố định chứ không phải "24 tiếng kể từ lần trước": kiểu trôi dần khiến
  /// chủ shop không bao giờ biết tỉ giá đổi lúc nào, và mỗi lần dựng lại máy chủ
  /// là mốc thời gian lại nhảy.
  rateHour           Int      @default(7)
  /// Lần lấy tỉ giá thành công gần nhất. null = chưa lần nào.
  rateUpdatedAt      DateTime?
  /// Nguồn + giá trị thô của lần lấy gần nhất, để chủ shop soi lại được.
  rateSource         String   @default("")

  /// --- Dịch tự động sang EN/ZH ---
  /// Chuẩn giao thức: "anthropic" hoặc "openai". Chọn "openai" là dùng được gần
  /// như mọi nhà cung cấp khác (OpenRouter, DeepSeek, Groq, Ark, Ollama nội bộ…)
  /// vì tất cả đều nói chung giao thức /chat/completions — chỉ khác địa chỉ gốc.
  aiProvider        String   @default("anthropic")
  /// Địa chỉ gốc API. Rỗng = địa chỉ mặc định của nhà cung cấp.
  aiBaseUrl         String   @default("")
  /// Tên model. Rỗng = claude-opus-5 (chỉ có nghĩa với Anthropic).
  aiModel           String   @default("")
  /// Khoá API cho dịch tự động.
  ///
  /// Là BÍ MẬT: không bao giờ nằm trong AdminStoreSettingDto, không bao giờ đi
  /// vào nhật ký thao tác (chỉ ghi "có/không"), và có mặt trong mọi bản pg_dump
  /// — đó là cái giá của việc cho sửa ngay trên web thay vì phải SSH vào máy chủ.
  /// Rỗng thì lùi về biến môi trường ANTHROPIC_API_KEY.
  aiApiKey          String   @default("")

  /// Danh sách kênh liên hệ hỗ trợ — mảng {label, value, url?}, admin tự sửa.
  /// Hiện ở khối "Quên mật khẩu" trang đăng nhập.
  supportChannels Json   @default("[]")
  /// Lời nhắn tùy chỉnh ở khối "Quên mật khẩu"; rỗng = dùng câu mặc định.
  supportNote String   @default("")
  updatedAt   DateTime @updatedAt
}

/// Hộp thông báo hiển thị trên trang chủ. Chỉ có duy nhất một bản ghi (id = "main").
/// `body` là HTML đã được lọc theo danh sách thẻ cho phép (xem sanitize-html.ts).
model Announcement {
  id        String   @id @default("main")
  active    Boolean  @default(false)
  title     String   @default("")
  body      String   @default("")
  updatedAt DateTime @updatedAt

  translations AnnouncementTranslation[]
}

model AnnouncementTranslation {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  locale         String
  title          String
  body           String

  updatedAt DateTime @updatedAt

  @@unique([announcementId, locale])
}

/// Trang chính sách của cửa hàng (điều khoản, hoàn tiền/bảo hành, bảo mật).
/// `slug` cố định theo LEGAL_PAGE_SLUGS trong @webcatt/shared — không cho tạo
/// tuỳ ý để đường dẫn công khai luôn ổn định.
/// `body` là HTML đã lọc qua đúng bộ allowlist của hộp thông báo.
model LegalPage {
  slug      String   @id
  title     String   @default("")
  body      String   @default("")
  updatedAt DateTime @updatedAt
}
