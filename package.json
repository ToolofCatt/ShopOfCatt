{
  "name": "webcatt",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:embedded": "pnpm --filter @webcatt/api db:embedded",
    "db:deploy": "pnpm --filter @webcatt/api db:deploy",
    "db:push": "pnpm --filter @webcatt/api db:push",
    "db:seed": "pnpm --filter @webcatt/api db:seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v",
    "test": "turbo test",
    "test:storectl": "docker run --rm -v .:/repo -w /repo alpine:3.20 sh scripts/storectl.spec.sh",
    "release:zip": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "archiver": "^7.0.1",
    "turbo": "^2.5.0"
  }
}
