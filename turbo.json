{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // .next/standalone chỉ dùng khi đóng gói Docker (build lại trong container),
      // không đưa vào cache vì symlink lồng sâu vượt giới hạn đường dẫn của Windows.
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/standalone/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
