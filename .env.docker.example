# ============================================================================
#  Cấu hình cho docker compose — COPY FILE NÀY THÀNH .env RỒI SỬA
#      cp .env.docker.example .env
#  (Windows PowerShell:  Copy-Item .env.docker.example .env)
# ============================================================================

# ⚠️ BA GIÁ TRỊ DƯỚI ĐÂY ĐỂ TRỐNG CÓ CHỦ Ý. Container sẽ từ chối khởi động cho
#    tới khi bạn tự điền — vì giá trị mẫu nằm công khai trong mã nguồn này, ai
#    đọc được repo cũng đăng nhập/ký token giả được. Sinh nhanh cả ba:
#
#      echo "JWT_SECRET=$(openssl rand -base64 48 | tr -d '\n')"
#      echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
#      echo "ADMIN_PASSWORD=$(openssl rand -base64 18 | tr -d '\n')"
#
#    Windows PowerShell (không có openssl):
#      -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})

# --- BẮT BUỘC: chuỗi bí mật ký JWT, tối thiểu 32 ký tự ---
JWT_SECRET=

# --- PostgreSQL ---
POSTGRES_USER=postgres
# BẮT BUỘC. CHỈ dùng chữ và số: mật khẩu nằm trong chuỗi kết nối
# postgresql://user:MAT_KHAU@postgres:5432/... nên các ký tự @ : / ? # % sẽ
# làm hỏng chuỗi và API không nối được vào CSDL.
POSTGRES_PASSWORD=
POSTGRES_DB=webcatt
# Cổng mở ra máy thật để bạn xem DB bằng công cụ ngoài (trong mạng Docker luôn là 5432)
POSTGRES_PORT=5433

# --- Cổng dịch vụ trên máy thật ---
WEB_PORT=3000
API_PORT=3001
# Địa chỉ lắng nghe của web/api. Mặc định 127.0.0.1 = CHỈ máy chủ tự gọi được,
# người ngoài phải đi qua proxy HTTPS. Đổi thành 0.0.0.0 là mở thẳng HTTP ra
# Internet, bỏ qua toàn bộ mã hoá — chỉ làm khi chạy trong máy để thử.
APP_BIND=127.0.0.1

# --- URL công khai ---
# WEB_URL: dùng cho CORS + link quay lại sau khi thanh toán
WEB_URL=http://localhost:3000
# API_PUBLIC_URL: Binance gọi webhook về đây — chạy thật phải là HTTPS public
API_PUBLIC_URL=http://localhost:3001

# URL trình duyệt dùng để gọi API (NHÚNG VÀO BUNDLE LÚC BUILD → đổi thì phải
# chạy lại `docker compose up -d --build`)
#   - Chạy 2 cổng riêng:   http://localhost:3001/api
#   - Chạy qua proxy (khuyến nghị): /api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_NAME=Catt Store
# Tên miền công khai (https://shop.cua-ban.com) — cho OpenGraph, robots.txt, sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Thanh toán ---
# ⚠️ CHỈ đặt true khi dev/demo. Cổng giả lập cho phép hoàn tất đơn mà KHÔNG trả
# tiền — bật ở cửa hàng thật là phát hàng miễn phí. Bất kỳ giá trị nào khác
# "true" (kể cả để trống) đều được hiểu là TẮT.
PAYMENT_MOCK=false

# Binance Pay (merchant) — cho phương thức "binance_pay"
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=

# Binance tài khoản thường — để TỰ ĐỘNG khớp khách nạp USDT BEP20/TRC20.
# Dùng khóa CHỈ CÓ QUYỀN ĐỌC (Enable Reading), không bật Withdraw/Trade,
# nên giới hạn theo IP máy chủ. Thiếu ba biến này thì crypto không đối soát được.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_API_BASE_URL=https://api.binance.com

# Đơn chưa thanh toán sẽ hết hạn và nhả kho sau số phút này
ORDER_EXPIRE_MINUTES=30

# Múi giờ dùng cho thống kê/biểu đồ doanh thu
TZ=Asia/Ho_Chi_Minh

# --- Tự động dịch nội dung sang EN + ZH bằng Claude API ---
# Lấy khóa tại https://platform.claude.com → API keys. Để trống = tắt tính năng dịch.
ANTHROPIC_API_KEY=

# --- Tài khoản chủ cửa hàng (BẮT BUỘC — seed dừng nếu thiếu) ---
# Chỉ được TẠO khi chưa tồn tại; chạy lại không ghi đè mật khẩu đang dùng.
ADMIN_EMAIL=ban@vidu.com
# BẮT BUỘC — seed từ chối chạy nếu để trống hoặc để nguyên giá trị mẫu.
ADMIN_PASSWORD=

# true = chạy seed khi khởi động container (chỉ bảo đảm có tài khoản chủ shop)
SEED_ON_START=true
# true = tạo thêm sản phẩm/khách hàng/thông báo MẪU. Cửa hàng thật để false.
SEED_DEMO=false

# --- HTTPS (dịch vụ `proxy` — chạy luôn, là đường vào duy nhất từ Internet) ---
# Tên miền đã trỏ A/AAAA về máy chủ này. Caddy tự xin và tự gia hạn chứng chỉ
# Let's Encrypt. Để "localhost" khi chạy thử trong máy (chứng chỉ tự ký).
SITE_DOMAIN=localhost
# Email nhận cảnh báo hết hạn chứng chỉ từ Let's Encrypt
ACME_EMAIL=
# Vì web và api dùng chung tên miền, bốn biến dưới PHẢI đổi theo rồi
# BUILD LẠI web (`docker compose up -d --build web`):
#   NEXT_PUBLIC_API_URL=/api
#   NEXT_PUBLIC_SITE_URL=https://shop.cua-ban.com
#   WEB_URL=https://shop.cua-ban.com
#   API_PUBLIC_URL=https://shop.cua-ban.com
# Cổng proxy — Let's Encrypt xác thực qua đúng 80/443, chỉ đổi khi chạy thử.
HTTP_PORT=80
HTTPS_PORT=443

# --- Sao lưu tự động (dịch vụ `backup`) ---
# Bản dump ghi vào ./backups trên máy chủ. NÊN đồng bộ thư mục này sang nơi khác
# (rclone/rsync/S3) — sao lưu nằm cùng ổ đĩa với CSDL thì hỏng ổ là mất cả hai.
BACKUP_INTERVAL=86400   # giây giữa hai lần dump (86400 = mỗi ngày)
BACKUP_KEEP=14          # số bản giữ lại

# Hạn riêng của chuyển khoản ngân hàng (SePay) — xem apps/api/.env.example.
SEPAY_EXPIRE_MINUTES=10
